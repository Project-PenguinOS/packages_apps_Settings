<?xml version="1.0" encoding="utf-8"?>
<!-- Fades the list into the page colour under the floating search bar; a dark fade reads as a
     shadow on the light theme. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:startColor="@color/settings_homepage_search_fade_start"
        android:endColor="@color/settings_homepage_search_fade_end"
        android:angle="90" />
</shape>
