<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:title="@string/qs_show_data_usage_title">

    <com.android.settings.custom.preference.SystemSettingMainSwitchPreference
        android:key="qs_show_data_usage"
        android:title="@string/qs_show_data_usage_title"
        android:defaultValue="false" />

    <com.android.settings.custom.preference.SystemSettingListPreference
        android:key="qs_show_data_usage_window"
        android:title="@string/qs_show_data_usage_window_title"
        android:entries="@array/qs_show_data_usage_window_entries"
        android:entryValues="@array/qs_show_data_usage_window_values"
        android:defaultValue="0"
        android:dependency="qs_show_data_usage" />

    <com.android.settingslib.widget.FooterPreference
        android:key="qs_data_usage_footer"
        android:title="@string/qs_show_data_usage_summary"
        android:selectable="false"
        settings:searchable="false" />

</PreferenceScreen>
